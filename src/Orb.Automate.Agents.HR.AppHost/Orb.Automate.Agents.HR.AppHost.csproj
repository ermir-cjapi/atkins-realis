<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.3" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsAspireHost>true</IsAspireHost>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <UserSecretsId>0c0f2a0e-6f0f-4d0a-9a9f-0b4f0a1e5a11</UserSecretsId>
    </PropertyGroup>

    <!-- The Aspire CLI bundle provides the dashboard/DCP needed to *run* the AppHost locally.
         Build agents only compile this project and don't have the Aspire CLI installed, which
         makes bundle resolution fail with ASPIRE009, so skip the bundle (and the dashboard/DCP
         package downloads) there. ASPIRE010 just reports that the bundle is disabled. -->
    <PropertyGroup>
        <AspireUseCliBundle Condition="'$(TF_BUILD)' == 'true'">false</AspireUseCliBundle>
        <AspireUseCliBundle Condition="'$(TF_BUILD)' != 'true'">true</AspireUseCliBundle>
        <SkipAddAspireDefaultReferences Condition="'$(AspireUseCliBundle)' != 'true'">true</SkipAddAspireDefaultReferences>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AgentFramework.DevUI" />
        <PackageReference Include="Aspire.Hosting.AppHost" />
        <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Orb.Automate.Agents.HR.Api\Orb.Automate.Agents.HR.Api.csproj" />
    </ItemGroup>

</Project>
