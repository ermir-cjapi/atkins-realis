{
  "Agent": {
    "Name": "Assist | HR",
    "MaxInputCharacters": 12000
  },
  "Foundry": {
    "Endpoint": "",
    "DeploymentName": "",
    "ReasoningEffort": ""
  },
  "ServiceNow": {
    "Enabled": false,
    "Endpoint": "",
    "TokenEndpoint": "",
    "SearchPath": "/api/atki2/ai_search",
    "ClientId": "",
    "ClientSecret": "",
    "TurnBudgetMilliseconds": 10000,
    "SearchAttemptTimeoutMilliseconds": 8000,
    "OAuthAttemptTimeoutMilliseconds": 3000,
    "SearchRetryCount": 1,
    "OAuthRetryCount": 1,
    "RetryBaseDelayMilliseconds": 100,
    "CircuitSamplingMilliseconds": 30000,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 10,
    "CircuitBreakMilliseconds": 30000,
    "RateLimitRequestsPerSecond": 5,
    "RateLimitBurst": 5,
    "RateLimitQueueLimit": 5,
    "CacheFreshMinutes": 15,
    "CacheMaximumStaleMinutes": 60,
    "CacheSizeLimit": 1000,
    "CacheVersion": "v1",
    "MaxSearchTermCharacters": 100,
    "MaxResults": 12,
    "MaxLlmResults": 5,
    "MaxLlmResultContentCharacters": 2500,
    "MaxLlmPayloadCharacters": 10000,
    "MaxTitleCharacters": 500,
    "MaxTextCharacters": 8000,
    "MaxColumns": 20,
    "MaxColumnValueCharacters": 8000
  },
  "EntraAuthentication": {
    "TenantId": "",
    "Audience": "",
    "RequiredScope": "access_as_user"
  },
  "Teams": {
    "Enabled": false,
    "AppId": "",
    "TenantId": "",
    "SsoEnabled": false,
    "AuthorizationHandler": "hr",
    "StorageContainerUri": ""
  },
  "AgentApplication": {
    "UserAuthorization": {
      "DefaultHandlerName": "hr",
      "AutoSignIn": false,
      "SignInFailedMessage": "I couldn't sign you in. Please try again or contact support.",
      "Handlers": {
        "hr": {
          "Settings": {
            "AzureBotOAuthConnectionName": "user.read",
            "EnableSso": true,
            "Title": "Sign in to Assist | HR",
            "Text": "Sign in with your work account to continue."
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Assembly": "Microsoft.Agents.Authentication.Msal",
      "Type": "MsalAuth",
      "Settings": {
        "AuthType": "UserManagedIdentity",
        "ClientId": "",
        "Scopes": [
          "https://api.botframework.com/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "CloudAdapterOptions": {
    "ValidateServiceUrl": true
  },
  "SharePointSearch": {
    "Enabled": false,
    "Endpoint": "",
    "IndexName": "",
    "SemanticConfigurationName": "",
    "EnforceDocumentPermissions": false,
    "CanonicalUrlBase": "",
    "VectorFieldName": "text_vector",
    "RequestTimeoutSeconds": 30,
    "MaxSearchTermCharacters": 100,
    "MaxResults": 12,
    "MaxLlmResults": 5,
    "MaxLlmResultContentCharacters": 2500,
    "MaxLlmPayloadCharacters": 10000,
    "MaxTitleCharacters": 500,
    "MinimumRerankerScore": 1.8,
    "MaxChunksPerParent": 2,
    "IncludeExtendedMetadata": false,
    "RequiredPublicationStatus": ""
  },
  "OnBehalfOf": {
    "TenantId": "",
    "ClientId": "",
    "UserTokenMode": "AzureCli",
    "ClientSecret": ""
  },
  "GraphProfile": {
    "Enabled": false,
    "BaseUri": "https://graph.microsoft.com/v1.0/",
    "CacheMinutes": 60,
    "RequestTimeoutSeconds": 5
  },
  "Telemetry": {
    "TaxonomyVersion": "1.1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*"
}
