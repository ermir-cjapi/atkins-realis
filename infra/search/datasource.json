  },
  "container": {
    "name": "defaultSiteLibrary",
    "query": "includeLibrary=__SHAREPOINT_LIBRARY_URL__;additionalColumns=Created"
  },
  "dataChangeDetectionPolicy": null,
  "dataDeletionDetectionPolicy": null,
  "encryptionKey": null,
  "identity": null
}
